# FortyGuard API Configuration
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Optional - Google Gemini API Key for autonomous LLM reasoning in LangGraph agents
GEMINI_API_KEY=your_gemini_api_key_here

# Backend & Port Settings
PORT=8080
HOST=0.0.0.0

# Comma-separated exact CORS origins (no wildcards — use CORS_ORIGIN_REGEX for those)
ALLOWED_ORIGINS=https://formaguard.pages.dev,https://app.autodeskforma.com,https://app.autodeskforma.eu,http://localhost:3000,http://localhost:5173

# Frontend → backend base URL (no trailing slash)
# Local: http://localhost:8080
# Firebase Hosting (rewrites /api/** → Cloud Run): https://YOUR_FIREBASE_PROJECT_ID.web.app
# Direct Cloud Run: https://formaguard-backend-XXXXXX-uc.a.run.app
VITE_AGENT_BACKEND_URL=http://localhost:8080
