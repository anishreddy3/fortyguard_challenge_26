# Copied into forma_extension/.env.production before `npm run build`.
# Vite inlines VITE_* at build time — do not rely on wrangler [vars] for these.

# Prefer Firebase Hosting URL (rewrites /api/** → Cloud Run):
# VITE_AGENT_BACKEND_URL=https://YOUR_FIREBASE_PROJECT_ID.web.app

# Or call Cloud Run directly:
VITE_AGENT_BACKEND_URL=https://formaguard-backend-XXXXXX-uc.a.run.app
